<!--
    앱 아이콘 원본 (256 x 256 벡터).
    설정창 머리글에서 그대로 쓰고, tools\Generate-Icon.ps1이 이 파일로 AppIcon.ico를 만든다.
    어두운 방패(차단) 안의 노란 말풍선(카카오톡).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingImage x:Key="AppIconImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 크기 기준 -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />

                <!-- 방패 -->
                <GeometryDrawing Geometry="M128,10 C162,28 198,34 234,34 L234,118 C234,184 190,226 128,248 C66,226 22,184 22,118 L22,34 C58,34 94,28 128,10 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#4A2C2A" />
                            <GradientStop Offset="1" Color="#2A1716" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>

                <!-- 방패 안쪽 윤곽 (밝은 테) -->
                <GeometryDrawing Geometry="M128,26 C158,41 190,47 220,48 L220,118 C220,174 183,210 128,231 C73,210 36,174 36,118 L36,48 C66,47 98,41 128,26 Z">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="4" Brush="#33FFFFFF" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- 말풍선 -->
                <GeometryDrawing Geometry="M128,62 C176,62 206,90 206,124 C206,158 176,186 128,186 C119,186 110,185 102,183 L74,204 L80,172 C60,161 50,144 50,124 C50,90 80,62 128,62 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FFEB3B" />
                            <GradientStop Offset="1" Color="#FFD000" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>

                <!-- 차단 표시 (말풍선을 가로지르는 사선) -->
                <GeometryDrawing Geometry="M92,92 L164,156">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="18" Brush="#3C1E1E" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
