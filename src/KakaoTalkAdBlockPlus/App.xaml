<Application x:Class="KakaoTalkAdBlockPlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 0번은 색 사전: ThemeManager가 윈도우 테마에 맞춰 Light/Dark로 바꿔 끼운다. -->
                <ResourceDictionary Source="UI/Themes/Light.xaml" />
                <ResourceDictionary Source="UI/Themes/Controls.xaml" />
                <ResourceDictionary Source="Assets/AppIconDrawing.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
