<!-- 다크 테마 색. Light.xaml과 키가 같아야 한다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#17171C" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#222228" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E2E36" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A8B2" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7E8491" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2E2E36" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2C2C33" />
    <SolidColorBrush x:Key="PressedBrush" Color="#35353D" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FEE500" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFEA33" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E9CF00" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#191919" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#FEE500" />

    <SolidColorBrush x:Key="SliderTrackBrush" Color="#3A3A44" />
    <SolidColorBrush x:Key="SliderFillBrush" Color="#FFD400" />
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ToggleOffTrackBrush" Color="#4A4A55" />
    <SolidColorBrush x:Key="ToggleOffThumbBrush" Color="#E9EAEE" />
    <SolidColorBrush x:Key="ToggleOnTrackBrush" Color="#FEE500" />
    <SolidColorBrush x:Key="ToggleOnThumbBrush" Color="#3C1E1E" />

    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FFD400" />
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#2FD68E" />
    <SolidColorBrush x:Key="StatusWaitingBrush" Color="#6C717C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B75" />
    <Color x:Key="ShadowColor">#40000000</Color>
</ResourceDictionary>
