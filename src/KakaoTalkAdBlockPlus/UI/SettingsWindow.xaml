<Window x:Class="KakaoTalkAdBlockPlus.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KakaoTalkAdBlockPlus.UI"
        Title="카카오톡 광고 차단 설정"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/KakaoTalkAdBlockPlus;component/Assets/AppIcon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <ui:TextToVisibilityConverter x:Key="TextToVisibility" />
        <ui:InverseBooleanToVisibilityConverter x:Key="HiddenWhenTrue" />
    </Window.Resources>

    <StackPanel Margin="22,18,22,22">
        <!-- 머리글 -->
        <DockPanel>
            <Image Width="46" Height="46" Source="{StaticResource AppIconImage}" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleText}" Text="카카오톡 광고 차단" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           Text="트레이에 머물면서 카카오톡 광고를 자동으로 정리해요" />
            </StackPanel>
        </DockPanel>

        <!-- 현재 상태 -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,14">
            <DockPanel>
                <Grid Width="12" Height="12" Margin="2,0,14,0" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource StatusRunningBrush}" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKakaoTalkRunning}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Pulse">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.6" Duration="0:0:1.6" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.6" Duration="0:0:1.6" />
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.6" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StatusWaitingBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKakaoTalkRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource StatusRunningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongText}" Text="{Binding StatusTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" Text="{Binding StatusDetail}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 광고 확인 주기 -->
        <TextBlock Style="{StaticResource SectionHeaderText}" Text="광고 확인 주기" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                            Style="{StaticResource SubtleButton}" Content="기본값 0.1초로"
                            Click="OnResetIntervalClick"
                            Visibility="{Binding IsDefaultInterval, Converter={StaticResource HiddenWhenTrue}}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="IntervalBox" Style="{StaticResource NumberTextBox}"
                                 Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="숫자를 눌러 직접 입력하고 Enter를 누르세요"
                                 AutomationProperties.Name="광고 확인 주기(초)"
                                 KeyDown="OnIntervalKeyDown"
                                 LostKeyboardFocus="OnIntervalLostKeyboardFocus" />
                        <TextBlock Margin="6,6,0,0" VerticalAlignment="Center" FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="초마다 확인" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding IntervalError}"
                           Visibility="{Binding IntervalError, Converter={StaticResource TextToVisibility}}" />

                <Slider x:Name="IntervalSlider" Margin="0,14,0,2" Minimum="0"
                        Style="{StaticResource ModernSlider}"
                        AutomationProperties.Name="광고 확인 주기 단계"
                        Value="{Binding IntervalStepIndex}" />
                <DockPanel Margin="4,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintText}" Text="느긋하게 · 60초" />
                    <TextBlock Style="{StaticResource HintText}" Text="빠르게 · 0.05초" />
                </DockPanel>

                <Border Style="{StaticResource Divider}" />
                <!-- 한글은 글자 단위로 줄이 바뀌므로 문장마다 직접 줄을 나눈다. -->
                <TextBlock Style="{StaticResource CaptionText}">
                    <Run Text="짧을수록 광고가 빨리 사라지지만 CPU를 조금 더 써요." />
                    <LineBreak />
                    <Run Text="원본 프로그램은 0.1초마다 확인해요." />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 일반 -->
        <TextBlock Style="{StaticResource SectionHeaderText}" Text="일반" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="윈도우 시작 시 자동 실행"
                              IsChecked="{Binding StartWithWindows}" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource BodyStrongText}" Text="윈도우 시작 시 자동 실행" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                   Text="로그인하면 창 없이 트레이에서 조용히 시작해요" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StartupError}"
                           Visibility="{Binding StartupError, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- 아래쪽 -->
        <DockPanel Margin="4,22,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="닫기"
                    IsCancel="True" Click="OnCloseClick" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,16,0" VerticalAlignment="Center">
                <Run Text="변경 사항은 바로 저장돼요." />
                <LineBreak />
                <Run Text="창을 닫아도 트레이에서 계속 광고를 차단해요." />
            </TextBlock>
        </DockPanel>
    </StackPanel>
</Window>
